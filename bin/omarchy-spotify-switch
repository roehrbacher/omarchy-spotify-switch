#!/usr/bin/env python3
"""Spotify Switcher backend for the timon.spotify-switch bar icon.

  omarchy-spotify-switch status            JSON: current device, all devices, cycle order
  omarchy-spotify-switch next [--from ID]  move playback to the next device in the cycle
  omarchy-spotify-switch to ID             move playback to that device (the popup's choice)
  omarchy-spotify-switch disable ID        never switch to that device (config "disabled")
  omarchy-spotify-switch enable ID         switch to that device again
  omarchy-spotify-switch serve             the bar's helper: commands on stdin, JSON lines out
  omarchy-spotify-switch login             browser login (Authorization Code + PKCE)
  omarchy-spotify-switch logout            forget the saved tokens
  omarchy-spotify-switch cached            last known status (no network)

Config  $XDG_CONFIG_HOME/timon-spotify-switch/config.json
          {"client_id": "...", "order": ["Pixel", "gaming PC", "XPS"], "timing": false,
           "disabled": [{"id": "<device id>", "name": "Kurt's Fire TV"}]}
        "disabled": devices the switcher never moves playback to (the right click
        skips them, the popup refuses them). An entry matches by device id; when
        that id is not in Spotify's list any more, by device name instead.
        SPOTIFY_SWITCH_CLIENT_ID overrides client_id; SPOTIFY_SWITCH_TIMING=1 or
        "timing": true logs each click's stages to timing.log in the state dir.
Tokens  $XDG_STATE_HOME/timon-spotify-switch/token.json (dir 700, file 600)
Cache   $XDG_STATE_HOME/timon-spotify-switch/status.json (what the bar shows)

Python 3 standard library only. status/next always print one JSON object and
exit 0 (the state is in the JSON); login/logout exit non-zero on failure.

A click costs one PUT: the device list and play state come from the cache
(refreshed in the background), the token is kept fresh ahead of time and
`serve` keeps one HTTPS connection to Spotify open. Only a 404 (device gone)
or an old cache reads Spotify again on the click path.
"""
import fcntl
import json
import os
import re
import sys
import tempfile
import threading
import time

APP = "timon-spotify-switch"
HOME = os.path.expanduser("~")
CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), APP)
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state"), APP)
CONFIG = os.path.join(CONFIG_DIR, "config.json")
TOKEN = os.path.join(STATE_DIR, "token.json")
CACHE = os.path.join(STATE_DIR, "status.json")
LOCK = os.path.join(STATE_DIR, "lock")
TIMING_LOG = os.path.join(STATE_DIR, "timing.log")
SCOPES = "user-read-playback-state user-modify-playback-state"
# The only redirect URI registered for the app. Tests move the port.
PORT = int(os.environ.get("SPOTIFY_SWITCH_LOGIN_PORT") or 8888)
REDIRECT_URI = "http://127.0.0.1:%d/callback" % PORT
LOGIN_TIMEOUT = float(os.environ.get("SPOTIFY_SWITCH_LOGIN_TIMEOUT") or 180)
HTTP_TIMEOUT = 8
RETRY_AFTER_MAX = 3      # wait this long at most for a 429 before giving up
TOKEN_MARGIN = 60        # refresh when the access token expires within this (click path)
TOKEN_WARM = 600         # background reads refresh earlier, so clicks never wait on it
PLAYING_FRESH_MS = 15000  # cached play state this young is trusted on a click
DEVICES_FRESH_MS = 600000  # cached device list this young is used on a click (404 -> re-read)
TRUST_TRANSFER_MS = 6000  # Spotify may still report the old device this long after a transfer


def now_ms():
    return int(time.time() * 1000)


def _base(env, default):
    """API endpoints. Tests point them at a local fake; nothing else is allowed,
    so an environment variable can never send tokens to another host."""
    v = os.environ.get(env)
    if not v:
        return default
    if not re.fullmatch(r"http://127\.0\.0\.1:\d{1,5}", v):
        sys.exit("%s may only point at http://127.0.0.1:<port> (tests)" % env)
    return v


API = _base("SPOTIFY_SWITCH_API", "https://api.spotify.com")
ACCOUNTS = _base("SPOTIFY_SWITCH_ACCOUNTS", "https://accounts.spotify.com")


class Fail(Exception):
    """A state the bar shows: state (machine word) + tooltip text."""

    def __init__(self, state, message, retry_after=None):
        super().__init__(message)
        self.state, self.message, self.retry_after = state, message, retry_after


# ---------- files ----------

def private_dir():
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    os.chmod(STATE_DIR, 0o700)


def write_private(path, data):
    """Atomic write, mode 600, in the 700 state dir."""
    private_dir()
    fd, tmp = tempfile.mkstemp(dir=STATE_DIR, prefix=".tmp-")
    try:
        with os.fdopen(fd, "w") as f:
            os.fchmod(f.fileno(), 0o600)
            json.dump(data, f)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def config():
    c = read_json(CONFIG)
    return c if isinstance(c, dict) else {}


def write_config(cfg):
    """Atomic write of config.json, mode 600 (it holds the client ID)."""
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=CONFIG_DIR, prefix=".tmp-")
    try:
        with os.fdopen(fd, "w") as f:
            os.fchmod(f.fileno(), 0o600)
            json.dump(cfg, f, indent=2, ensure_ascii=False)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, CONFIG)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def entry_parts(entry):
    """(id, casefolded name) of a "disabled" entry: {"id", "name"} or a bare
    string (matches an id or a name). Anything else matches nothing."""
    if isinstance(entry, str):
        return entry, entry.casefold()
    if isinstance(entry, dict):
        i, n = entry.get("id"), entry.get("name")
        return (i if isinstance(i, str) else ""), (n.casefold() if isinstance(n, str) else "")
    return "", ""


def entry_matches(entry, dev, known_ids):
    """By device id; by name only when the entry's id is not in Spotify's
    list (ids can change, names are what you recognise)."""
    eid, ename = entry_parts(entry)
    if eid and eid == dev["id"]:
        return True
    return bool(ename) and ename == dev["name"].casefold() and eid not in known_ids


def mark_enabled(devs):
    """Set d["enabled"] on every device from the config's "disabled" list."""
    entries = config().get("disabled")
    entries = entries if isinstance(entries, list) else []
    ids = {d["id"] for d in devs}
    for d in devs:
        d["enabled"] = not any(entry_matches(e, d, ids) for e in entries)
    return devs


def client_id():
    cid = os.environ.get("SPOTIFY_SWITCH_CLIENT_ID") or str(config().get("client_id") or "")
    cid = cid.strip()
    if not cid:
        raise Fail("no_client_id", "Spotify: no client ID set (see README)")
    return cid


def timing_on():
    return os.environ.get("SPOTIFY_SWITCH_TIMING") == "1" or config().get("timing") is True


def timing(event, **stages):
    """Opt-in: one JSON line per click with its stages in ms (no tokens, no ids)."""
    if not timing_on():
        return
    try:
        private_dir()
        if os.path.exists(TIMING_LOG) and os.path.getsize(TIMING_LOG) > 262144:
            os.replace(TIMING_LOG, TIMING_LOG + ".1")
        fd = os.open(TIMING_LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a") as f:
            f.write(json.dumps(dict({"t": time.strftime("%Y-%m-%d %H:%M:%S"), "event": event}, **stages)) + "\n")
    except OSError:
        pass


class Lock:
    """One process (or thread) at a time touches the tokens (a refresh rotates them)."""

    def __enter__(self):
        private_dir()
        self.f = open(LOCK, "a")
        os.chmod(LOCK, 0o600)
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *a):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


# ---------- HTTP (keep-alive, a small shared pool per host) ----------

_pool = {}
_pool_lock = threading.Lock()


def request(method, url, body=None, form=None, token=None):
    """Returns (status, headers, parsed JSON or None). Raises Fail('offline').
    Takes an idle open connection to the host if there is one (so a click
    reuses the one the last background read warmed up) and puts it back
    after. A connection the server closed while idle is reopened once
    (PUT /me/player is idempotent)."""
    import http.client
    import ssl
    import urllib.parse
    u = urllib.parse.urlsplit(url)
    path = u.path + ("?" + u.query if u.query else "")
    headers = {"Accept": "application/json"}
    data = None
    if form is not None:
        data = urllib.parse.urlencode(form).encode()
        headers["Content-Type"] = "application/x-www-form-urlencoded"
    elif body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    elif method in ("PUT", "POST"):
        data = b""
    if token:
        headers["Authorization"] = "Bearer " + token
    key = (u.scheme, u.netloc)
    for attempt in (0, 1):
        with _pool_lock:
            idle = _pool.setdefault(key, [])
            conn = idle.pop() if idle else None
        reused = conn is not None
        if conn is None:
            if u.scheme == "https":
                conn = http.client.HTTPSConnection(u.netloc, timeout=HTTP_TIMEOUT, context=ssl.create_default_context())
            else:
                conn = http.client.HTTPConnection(u.netloc, timeout=HTTP_TIMEOUT)
        try:
            conn.request(method, path, body=data, headers=headers)
            r = conn.getresponse()
            raw = r.read()
            status, hdrs = r.status, r.headers
            if r.will_close:
                conn.close()
            else:
                with _pool_lock:
                    _pool[key].append(conn)
            break
        except (http.client.HTTPException, OSError):
            conn.close()
            if reused and attempt == 0:
                continue
            raise Fail("offline", "Spotify: offline")
    try:
        parsed = json.loads(raw) if raw else None
    except ValueError:
        parsed = None
    return status, hdrs, parsed


def error_reason(data):
    err = (data or {}).get("error") if isinstance(data, dict) else None
    if isinstance(err, dict):
        return str(err.get("reason") or ""), str(err.get("message") or "")
    return "", str(err or "")


# ---------- tokens ----------

def save_token(resp, old_refresh=None):
    tok = {
        "access_token": resp["access_token"],
        # Spotify may rotate the refresh token; keep the old one if it doesn't.
        "refresh_token": resp.get("refresh_token") or old_refresh,
        "expires_at": int(time.time()) + int(resp.get("expires_in") or 3600),
        "scope": resp.get("scope") or SCOPES,
    }
    if not tok["refresh_token"]:
        raise Fail("need_login", "Spotify: not logged in (run omarchy-spotify-switch-login)")
    write_private(TOKEN, tok)
    return tok


def refresh(tok):
    status, _, data = request("POST", ACCOUNTS + "/api/token", form={
        "grant_type": "refresh_token",
        "refresh_token": tok["refresh_token"],
        "client_id": client_id(),
    })
    if status == 200 and isinstance(data, dict) and data.get("access_token"):
        return save_token(data, tok["refresh_token"])
    if status in (400, 401):  # invalid_grant: revoked or expired refresh token
        raise Fail("need_login", "Spotify: login expired (run omarchy-spotify-switch-login)")
    if status == 429:
        raise Fail("rate_limited", "Spotify: busy, try again in a moment")
    raise Fail("error", "Spotify: token refresh failed (%s)" % status)


def access_token(force=False, margin=TOKEN_MARGIN):
    """Valid access token, refreshed under the lock when due. The token file is
    re-read every time (another bar or the CLI may have rotated it)."""
    client_id()
    with Lock():
        tok = read_json(TOKEN)
        if not isinstance(tok, dict) or not tok.get("refresh_token"):
            raise Fail("need_login", "Spotify: not logged in (run omarchy-spotify-switch-login)")
        if force or not tok.get("access_token") or int(tok.get("expires_at") or 0) - margin < time.time():
            tok = refresh(tok)
        return tok["access_token"]


def api(method, path, body=None, margin=TOKEN_MARGIN):
    """Web API call: one refresh on 401, one short wait on 429."""
    token = access_token(margin=margin)
    refreshed = waited = False
    while True:
        status, hdrs, data = request(method, API + path, body=body, token=token)
        if status == 401 and not refreshed:
            refreshed = True
            token = access_token(force=True)
            continue
        if status == 401:
            raise Fail("need_login", "Spotify: not logged in (run omarchy-spotify-switch-login)")
        if status == 429:
            try:
                ra = max(1, int(hdrs.get("Retry-After") or 1))
            except ValueError:
                ra = 1
            if not waited and ra <= RETRY_AFTER_MAX:
                waited = True
                time.sleep(ra)
                continue
            raise Fail("rate_limited", "Spotify: busy, try again in %ds" % ra, retry_after=ra)
        if status == 403:
            reason, msg = error_reason(data)
            if reason == "PREMIUM_REQUIRED" or "premium" in msg.lower():
                raise Fail("premium", "Spotify: Premium needed to switch devices")
            raise Fail("error", "Spotify refused: " + (msg or "403"))
        if status >= 500:
            raise Fail("error", "Spotify: server error (%d)" % status)
        return status, data


# ---------- devices and the cycle ----------

def devices(margin=TOKEN_MARGIN):
    status, data = api("GET", "/v1/me/player/devices", margin=margin)
    if status != 200 or not isinstance(data, dict):
        raise Fail("error", "Spotify: unexpected answer (%d)" % status)
    out = []
    for d in data.get("devices") or []:
        if not d.get("id"):
            continue  # Spotify sends id null for some devices; they can't be targeted
        out.append({
            "id": d["id"],
            "name": str(d.get("name") or "Unknown device"),
            "type": str(d.get("type") or ""),
            "active": bool(d.get("is_active")),
            "restricted": bool(d.get("is_restricted")),
        })
    return out


def player(margin=TOKEN_MARGIN):
    """(is_playing, active device id or None) from GET /me/player (204: no session)."""
    status, data = api("GET", "/v1/me/player", margin=margin)
    if status == 200 and isinstance(data, dict):
        return bool(data.get("is_playing")), ((data.get("device") or {}).get("id"))
    return False, None


def valid_devices(devs):
    """A cached device list is used only if every entry has the fields the
    cycle needs (the cache is a plain file anyone in the session can edit)."""
    return isinstance(devs, list) and all(
        isinstance(d, dict) and isinstance(d.get("id"), str) and d["id"] and isinstance(d.get("name"), str)
        and isinstance(d.get("active", False), bool) and isinstance(d.get("restricted", False), bool)
        for d in devs)


def rank(name, order):
    """Position in the preferred order: an entry matches a device whose name
    equals it or starts with it (case-insensitive). Unlisted devices: len(order)."""
    n = name.casefold()
    for i, entry in enumerate(order):
        e = str(entry).casefold()
        if e and (n == e or n.startswith(e)):
            return i
    return len(order)


def cycle(devs, order=None):
    """Fixed order: preferred names first (in config order), then the rest
    alphabetically by name, then by id so equal names stay stable."""
    order = order if order is not None else (config().get("order") or [])
    if not isinstance(order, list):
        order = []
    return mark_enabled(sorted(devs, key=lambda d: (rank(d["name"], order), d["name"].casefold(), d["id"])))


def can_target(d):
    return not d["restricted"] and d.get("enabled", True)


def no_target_message(ordered, current):
    """Why a right click has nowhere to go."""
    free = [d for d in ordered if not d["restricted"]]
    off = [d for d in free if not d.get("enabled", True)]
    who = current["name"] if current else "this device"
    if off and len(off) == len(free):
        return "Spotify: all devices are turned off (left click to turn one on)"
    if off:
        return "Spotify: %s (only enabled device)" % who
    return "Spotify: %s (only device available)" % who


def next_device(ordered, from_id=None):
    """The device after from_id (or the active one), wrapping; restricted and
    disabled devices are skipped (the current one may be disabled: the cycle
    still starts from its place). None active -> the first one. Returns
    (target, current)."""
    current = None
    if from_id:
        current = next((d for d in ordered if d["id"] == from_id), None)
    if current is None:
        current = next((d for d in ordered if d["active"]), None)
    usable = [d for d in ordered if can_target(d)]
    if not usable:
        return None, current
    if current is None:
        return usable[0], None
    i = ordered.index(current)
    for k in range(1, len(ordered) + 1):
        d = ordered[(i + k) % len(ordered)]
        if can_target(d) and d is not current:
            return d, current
    return None, current  # current is the only usable device


# ---------- results ----------

def result(state, ordered, message=None, current=None, playing=None, transfer=None):
    mark_enabled(ordered)  # the setting may have changed while Spotify answered
    active = current or next((d for d in ordered if d["active"]), None)
    nxt, _ = next_device(ordered, active["id"] if active else None) if ordered else (None, None)
    if message is None:
        if state == "ok" and active:
            message = "Spotify: " + active["name"]
        elif state == "ok" and nxt:
            message = "Spotify: no active device, click to play on " + nxt["name"]
        elif state == "ok" and any(not d["restricted"] for d in ordered):
            message = "Spotify: all devices are turned off"
        elif state == "ok":
            message = "Spotify: no device"
        else:
            message = "Spotify: no device (open Spotify on a device)"
    out = {
        "state": state,
        "device": active,
        "next": nxt,
        "devices": ordered,
        "playing": playing,
        "tooltip": message,
        "updated": int(time.time()),
        "read_ms": now_ms(),
    }
    if transfer:
        out["transfer"] = transfer
    return out


KEEP_ON_FAIL = ("offline", "rate_limited", "premium", "error")


def failed(e):
    """Keep the last known devices on the bar with the failure in the tooltip."""
    last = read_json(CACHE) or {}
    keep = e.state in KEEP_ON_FAIL
    devs = last.get("devices") if isinstance(last.get("devices"), list) else []
    out = {
        "state": e.state,
        "device": last.get("device") if keep else None,
        "next": last.get("next") if keep else None,
        "devices": devs if keep else [],
        "playing": last.get("playing"),
        "tooltip": e.message,
        "updated": int(time.time()),
        "read_ms": int(last.get("read_ms") or 0) if keep else 0,
    }
    if e.state == "offline" and out["device"]:
        out["tooltip"] = "Spotify: %s (offline, last known)" % out["device"]["name"]
    if e.retry_after:
        out["retry_after"] = e.retry_after
    return out


_emit_lock = threading.Lock()


def save(out, started_ms):
    """Cache the status for the bar. A run that started before the cache was
    last written (a slow read overtaken by a click) leaves the newer cache alone."""
    out["updated_ms"] = now_ms()
    try:
        with Lock():
            # A switch turned on/off while Spotify answered (set_enabled holds
            # this lock while it writes): what is printed and cached agrees.
            if valid_devices(out.get("devices")) and out["devices"]:
                mark_enabled(out["devices"])
                active = next((d for d in out["devices"] if d.get("active")), None)
                out["next"] = next_device(out["devices"], active["id"] if active else None)[0]
            last = read_json(CACHE) or {}
            if int(last.get("updated_ms") or 0) <= started_ms:
                write_private(CACHE, out)
    except (OSError, ValueError, TypeError):
        pass


def read_status(margin=TOKEN_MARGIN):
    """Fresh status from Spotify: devices + play state. Right after a transfer
    Spotify can still name the old device; the transfer's target wins then."""
    started = now_ms()
    try:
        raw = devices(margin=margin)
        playing, active_id = player(margin=margin)
        ordered = cycle(raw)  # after the reads, so the freshest "disabled" setting counts
        last = read_json(CACHE) or {}
        tr = last.get("transfer") if isinstance(last.get("transfer"), dict) else None
        lagging = active_id is None or active_id == tr.get("from") if tr else False
        if tr and lagging and started - int(tr.get("at_ms") or 0) < TRUST_TRANSFER_MS and any(d["id"] == tr.get("id") for d in ordered):
            for d in ordered:
                d["active"] = d["id"] == tr["id"]
            playing = bool(tr.get("playing")) if tr.get("playing") is not None else playing
        elif active_id and any(d["id"] == active_id for d in ordered):
            for d in ordered:
                d["active"] = d["id"] == active_id
        out = result("ok" if ordered else "no_device", ordered, playing=playing, transfer=tr)
    except Fail as e:
        out = failed(e)
    save(out, started)
    return out


def pick(ordered, to_id):
    """(target, current, message) for a chosen device: message is set when
    there is nothing to transfer (gone, restricted, already active)."""
    current = next((d for d in ordered if d["active"]), None)
    target = next((d for d in ordered if d["id"] == to_id), None)
    if target is None:
        return None, current, "Spotify: that device is no longer available"
    if target["restricted"]:
        return None, current, "Spotify: %s can't be controlled from here" % target["name"]
    if current is not None and current["id"] == target["id"]:
        return None, current, "Spotify: " + target["name"]
    if not target.get("enabled", True):
        return None, current, "Spotify: %s is turned off for switching" % target["name"]
    return target, current, None


def click(from_id=None, t_click=None, to_id=None):
    """Move playback to the next device, or to to_id (the popup's choice).
    Uses the cached device list and play state when they are fresh enough, so
    the click path is one PUT. The play state is kept either way."""
    started = now_ms()
    st = {"queued": started - t_click if t_click else None}
    try:
        last = read_json(CACHE) or {}
        age = started - int(last.get("read_ms") or 0)
        ordered = last.get("devices") if last.get("state") == "ok" and valid_devices(last.get("devices")) else None
        t = time.perf_counter()
        if not ordered or age > DEVICES_FRESH_MS:
            ordered = cycle(devices())
            st["get_devices"] = round((time.perf_counter() - t) * 1000)
            playing = None
        else:
            ordered = cycle([dict(d, active=bool(d.get("active")), restricted=bool(d.get("restricted"))) for d in ordered])
            playing = last.get("playing") if age <= PLAYING_FRESH_MS else None
        if not ordered:
            out = result("no_device", ordered)
            save(out, started)
            return out, st
        if to_id:
            target, current, note = pick(ordered, to_id)
            if note and "get_devices" not in st and not any(d["id"] == to_id for d in ordered):
                # Not in the cached list: read it once before giving up.
                t = time.perf_counter()
                ordered = cycle(devices())
                st["get_devices"] = round((time.perf_counter() - t) * 1000)
                playing = None
                target, current, note = pick(ordered, to_id)
            if note:
                out = result("ok" if ordered else "no_device", ordered, current=current,
                             playing=last.get("playing"), message=note)
                if "get_devices" in st:
                    save(out, started)
                return out, st
        else:
            target, current = next_device(ordered, from_id)
        if target is None:
            out = result("ok", ordered, current=current, playing=last.get("playing"),
                         message=no_target_message(ordered, current))
            return out, st
        if playing is None:
            # Old cache: ask once. Keeps the play state: playing stays playing,
            # paused stays paused (no surprise music).
            t = time.perf_counter()
            playing, _ = player()
            st["get_player"] = round((time.perf_counter() - t) * 1000)
        t = time.perf_counter()
        access_token()
        st["token"] = round((time.perf_counter() - t) * 1000, 1)
        body = {"device_ids": [target["id"]]}
        if playing:
            body["play"] = True  # without it Spotify keeps the paused/playing state as it was
        t = time.perf_counter()
        status, _ = api("PUT", "/v1/me/player", body=body)
        st["put"] = round((time.perf_counter() - t) * 1000)
        if status == 404 and to_id:
            # The chosen device left Spotify Connect: show the fresh list, no
            # surprise move to another device.
            ordered = cycle(devices())
            out = result("ok" if ordered else "no_device", ordered,
                         message="Spotify: %s is no longer available" % target["name"])
            save(out, started)
            return out, st
        if status == 404:
            # The device left Spotify Connect: read the list again, once.
            t = time.perf_counter()
            ordered = cycle(devices())
            st["get_devices_404"] = round((time.perf_counter() - t) * 1000)
            gone = target["name"]
            target, current = next_device(ordered, from_id if any(d["id"] == from_id for d in ordered) else None)
            if target is None:
                out = result("ok" if ordered else "no_device", ordered,
                             message="Spotify: %s is no longer available" % gone)
                save(out, started)
                return out, st
            body["device_ids"] = [target["id"]]
            status, _ = api("PUT", "/v1/me/player", body=body)
            if status == 404:
                out = result("ok", ordered, message="Spotify: %s is no longer available" % target["name"])
                save(out, started)
                return out, st
        if status not in (200, 202, 204):
            raise Fail("error", "Spotify: transfer failed (%d)" % status)
        for d in ordered:
            d["active"] = d["id"] == target["id"]
        out = result("ok", ordered, current=target, playing=bool(playing),
                     transfer={"id": target["id"], "from": current["id"] if current else None,
                               "at_ms": now_ms(), "playing": bool(playing)})
        out["read_ms"] = int(last.get("read_ms") or 0) if "get_devices" not in st else now_ms()
    except Fail as e:
        out = failed(e)
    t = time.perf_counter()
    save(out, started)
    st["cache_write"] = round((time.perf_counter() - t) * 1000, 1)
    st["backend_total"] = now_ms() - started
    return out, st


def watch_handoff(target_id, t0_ms, limit_s=10):
    """Timing mode only: how long until Spotify reports the target active and
    its playback position moving (the device really plays)."""
    active_ms = moving_ms = None
    prev = None
    while time.time() * 1000 - t0_ms < limit_s * 1000:
        try:
            status, data = api("GET", "/v1/me/player")
        except Fail:
            break
        t = now_ms() - t0_ms
        if status == 200 and isinstance(data, dict) and (data.get("device") or {}).get("id") == target_id:
            if active_ms is None:
                active_ms = t
            p = data.get("progress_ms")
            if not data.get("is_playing"):
                break
            if prev is not None and p is not None and p > prev:
                moving_ms = t
                break
            prev = p
        time.sleep(0.2)
    return active_ms, moving_ms


def cmd_status():
    print(json.dumps(read_status()))


def cmd_next(from_id=None):
    out, st = click(from_id)
    print(json.dumps(out))
    sys.stdout.flush()
    if out.get("transfer"):
        timing("cli-next", **st)


def cmd_to(to_id):
    out, st = click(to_id=to_id)
    print(json.dumps(out))
    sys.stdout.flush()
    if out.get("transfer"):
        timing("cli-to", **st)


def set_enabled(dev_id, enabled):
    """Turn a device on or off for switching: update config.json's "disabled"
    list (atomic, mode 600) and the cached status the bars show. The entry
    holds the device id and name, so it still matches if Spotify hands the
    device a new id. Returns the cached device (or None when it is unknown)."""
    with Lock():
        cache = read_json(CACHE)
        cache = cache if isinstance(cache, dict) else {}
        devs = cache.get("devices") if valid_devices(cache.get("devices")) else []
        dev = next((d for d in devs if d["id"] == dev_id), None)
        ref = dev or {"id": dev_id, "name": ""}
        if os.path.exists(CONFIG):
            try:
                with open(CONFIG) as f:
                    cfg = json.load(f)
            except (OSError, ValueError):
                cfg = None
            if not isinstance(cfg, dict):
                raise Fail("error", "Spotify: config.json is not valid JSON, left unchanged")
        else:
            cfg = {}
        entries = cfg.get("disabled")
        entries = list(entries) if isinstance(entries, list) else []
        ids = {d["id"] for d in devs} | {dev_id}
        hits = [e for e in entries if entry_matches(e, ref, ids)]
        if enabled:
            entries = [e for e in entries if not any(e is h for h in hits)]
        elif not hits:
            entries.append({"id": dev_id, "name": ref["name"]})
        else:
            for e in hits:  # a name match: remember the id it has now
                if isinstance(e, dict):
                    e["id"] = dev_id
                    if ref["name"]:
                        e["name"] = ref["name"]
        if entries:
            cfg["disabled"] = entries
        else:
            cfg.pop("disabled", None)
        write_config(cfg)
        if devs and cache.get("state") == "ok":
            ordered = cycle([dict(d) for d in devs])
            active = next((d for d in ordered if d.get("active")), None)
            cache["devices"] = ordered
            cache["next"] = next_device(ordered, active["id"] if active else None)[0]
            cache["updated_ms"] = now_ms()
            cache["updated"] = int(time.time())
            write_private(CACHE, cache)
    return dev


def cmd_set_enabled(dev_id, enabled):
    try:
        dev = set_enabled(dev_id, enabled)
    except (Fail, OSError) as e:
        print(e.message if isinstance(e, Fail) else "Spotify: could not save the setting (%s)" % e.strerror,
              file=sys.stderr)
        return 1
    print(json.dumps({"id": dev_id, "name": dev["name"] if dev else None, "enabled": enabled}))
    return 0


def cmd_cached():
    out = read_json(CACHE)
    print(json.dumps(out if isinstance(out, dict) else {"state": "unknown", "tooltip": "Spotify", "devices": []}))


# ---------- serve: the bar's long-lived helper ----------

def cmd_serve():
    """Line protocol on stdin (one bar widget per process):
         status                 read Spotify in the background, answer a status line
         next <from-id|-> [ms]  click: answer a next line (ms = the widget's click time)
         to <device-id> [ms]    the popup's choice: answer a next line too
         seen <ms> <ms>         timing mode: the widget got the answer (click time, now)
       Answers: one JSON object per line with "kind": "status" | "next".
       Exits when stdin closes (the shell went away)."""
    out_lock = threading.Lock()
    status_wanted = threading.Event()
    clicks = []
    clicks_cv = threading.Condition()
    pending_timing = {}

    def send(kind, obj, extra=None):
        line = dict(obj, kind=kind)
        if extra:
            line.update(extra)
        with out_lock:
            sys.stdout.write(json.dumps(line) + "\n")
            sys.stdout.flush()
        return now_ms()

    def unexpected(e):
        # Never let a bug kill a worker: the widget waits for an answer.
        return {"state": "error", "tooltip": "Spotify: internal error (%s)" % type(e).__name__,
                "device": None, "next": None, "devices": [], "playing": None, "updated": int(time.time())}

    def status_loop():
        while True:
            status_wanted.wait()
            status_wanted.clear()
            try:
                out = read_status(margin=TOKEN_WARM)
            except Exception as e:  # noqa: BLE001
                out = unexpected(e)
            send("status", out)

    def click_loop():
        while True:
            with clicks_cv:
                while not clicks:
                    clicks_cv.wait()
                from_id, t_click, to_id = clicks.pop(0)
            try:
                out, st = click(from_id, t_click, to_id)
            except Exception as e:  # noqa: BLE001
                out, st = unexpected(e), {}
            t_sent = send("next", out, {"click_ms": t_click})
            if out.get("transfer"):
                if t_click:
                    pending_timing[t_click] = (st, t_sent, out["transfer"])
                if timing_on():
                    tr = out["transfer"]
                    threading.Thread(target=handoff_log, args=(t_click, tr), daemon=True).start()
                # Confirm with Spotify a moment later (the transfer's target is
                # trusted for TRUST_TRANSFER_MS, so this never flips the icon
                # back). A failed click keeps its message instead.
                threading.Timer(1.5, status_wanted.set).start()

    def handoff_log(t_click, tr):
        active_ms, moving_ms = watch_handoff(tr["id"], tr["at_ms"])
        timing("handoff", since_put_done_active=active_ms, since_put_done_playing=moving_ms,
               playing=tr.get("playing"))

    threading.Thread(target=status_loop, daemon=True).start()
    threading.Thread(target=click_loop, daemon=True).start()
    status_wanted.set()  # warm: token, connection, device list
    for line in sys.stdin:
        parts = line.split()
        if not parts:
            continue
        if parts[0] == "status":
            status_wanted.set()
        elif parts[0] == "next":
            from_id = parts[1] if len(parts) > 1 and parts[1] != "-" else None
            t_click = int(parts[2]) if len(parts) > 2 and parts[2].isdigit() else None
            with clicks_cv:
                clicks.append((from_id, t_click, None))
                clicks_cv.notify()
        elif parts[0] == "to" and len(parts) > 1:
            t_click = int(parts[2]) if len(parts) > 2 and parts[2].isdigit() else None
            with clicks_cv:
                clicks.append((None, t_click, parts[1]))
                clicks_cv.notify()
        elif parts[0] == "seen" and len(parts) >= 3 and parts[1].isdigit() and parts[2].isdigit():
            t_click, t_seen = int(parts[1]), int(parts[2])
            item = pending_timing.pop(t_click, None)
            if item:
                st, t_sent, tr = item
                timing("click", **dict(st, answer_to_widget=t_seen - t_sent, click_to_widget=t_seen - t_click,
                                       playing=tr.get("playing")))
        elif parts[0] == "quit":
            break
    return 0


# ---------- login ----------

def b64url(raw):
    import base64
    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode()


def cmd_login():
    import hashlib
    import http.server
    import secrets
    import subprocess
    import urllib.parse
    try:
        cid = client_id()
    except Fail:
        print("No Spotify client ID. Put it in %s as {\"client_id\": \"...\"}." % CONFIG, file=sys.stderr)
        return 1
    verifier = b64url(secrets.token_bytes(64))  # 86 chars, within PKCE's 43..128
    challenge = b64url(hashlib.sha256(verifier.encode()).digest())
    state = b64url(secrets.token_bytes(16))
    got = {}

    class Handler(http.server.BaseHTTPRequestHandler):
        timeout = 5  # an idle connection cannot hold the one-shot listener

        def log_message(self, *a):
            pass

        def do_GET(self):
            u = urllib.parse.urlparse(self.path)
            if u.path != "/callback":
                self.send_response(404)
                self.end_headers()
                return
            q = urllib.parse.parse_qs(u.query)
            ok = q.get("state", [""])[0] == state
            if ok:
                got["code"] = q.get("code", [""])[0]
                got["error"] = q.get("error", [""])[0]
            good = ok and got.get("code")
            self.send_response(200 if good else 400)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            msg = "Spotify Switcher is logged in. You can close this tab." if good else "Spotify login failed. You can close this tab."
            self.wfile.write(("<!doctype html><title>Spotify Switcher</title><p>%s</p>" % msg).encode())

    try:
        server = http.server.HTTPServer(("127.0.0.1", PORT), Handler)
    except OSError as e:
        print("Port %d on 127.0.0.1 is busy (%s). Close what uses it and try again." % (PORT, e.strerror), file=sys.stderr)
        return 1
    server.timeout = 1
    url = ACCOUNTS + "/authorize?" + urllib.parse.urlencode({
        "client_id": cid,
        "response_type": "code",
        "redirect_uri": REDIRECT_URI,
        "code_challenge_method": "S256",
        "code_challenge": challenge,
        "scope": SCOPES,
        "state": state,
    })
    print("Opening the Spotify login in your browser. If nothing opens, visit:\n" + url, file=sys.stderr)
    try:
        subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass
    deadline = time.time() + LOGIN_TIMEOUT
    try:
        while "code" not in got and time.time() < deadline:
            server.handle_request()
    finally:
        server.server_close()  # one-shot: the listener is gone after this
    if "code" not in got:
        print("Login timed out after %ds." % LOGIN_TIMEOUT, file=sys.stderr)
        return 1
    if got.get("error") or not got.get("code"):
        print("Spotify said: %s" % (got.get("error") or "no code"), file=sys.stderr)
        return 1
    try:
        status, _, data = request("POST", ACCOUNTS + "/api/token", form={
            "grant_type": "authorization_code",
            "code": got["code"],
            "redirect_uri": REDIRECT_URI,
            "client_id": cid,
            "code_verifier": verifier,
        })
        if status != 200 or not isinstance(data, dict) or not data.get("access_token"):
            print("Token exchange failed (%s): %s" % (status, error_reason(data)[1] or data), file=sys.stderr)
            return 1
        with Lock():
            save_token(data)
    except Fail as e:
        print(e.message, file=sys.stderr)
        return 1
    print("Logged in. Tokens saved to %s" % TOKEN, file=sys.stderr)
    cmd_status()
    return 0


def cmd_logout():
    try:
        os.unlink(TOKEN)
    except FileNotFoundError:
        pass
    out = failed(Fail("need_login", "Spotify: not logged in (run omarchy-spotify-switch-login)"))
    save(out, now_ms())
    print(json.dumps(out))
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    if cmd == "status":
        cmd_status()
    elif cmd == "next":
        from_id = argv[3] if len(argv) > 3 and argv[2] == "--from" else None
        cmd_next(from_id)
    elif cmd == "to" and len(argv) > 2:
        cmd_to(argv[2])
    elif cmd in ("enable", "disable") and len(argv) > 2:
        return cmd_set_enabled(argv[2], cmd == "enable")
    elif cmd == "serve":
        return cmd_serve()
    elif cmd == "cached":
        cmd_cached()
    elif cmd == "login":
        return cmd_login()
    elif cmd == "logout":
        return cmd_logout()
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 0 if cmd in ("-h", "--help", "help") else 2
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except (BrokenPipeError, KeyboardInterrupt):
        sys.exit(0)
